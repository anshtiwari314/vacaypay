## mobileApp 

# Google OAuth — mobileApp (Expo reads these from repo-root .env via metro.config.js)
# WEB client: ID token audience. Required on Android. Does not open a browser.
# ANDROID client in Google Cloud: package com.vacaypay + SHA-1 of the expo run:android keystore.
#   That client is not a redirect URI. EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID is used for the iOS URL scheme fallback.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Google AdMob test ids (Google's public samples). Full-screen interstitial.
# App ids use ~ and are baked in at `npx expo run:android`. Unit ids use / and are read by the app.
# Replace both with your AdMob ids before a store release.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL_ID=ca-app-pub-3940256099942544/1033173712
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL_ID=ca-app-pub-3940256099942544/4411468910
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=ca-app-pub-3940256099942544/6300978111
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=ca-app-pub-3940256099942544/2934735716

# Optional. Leave unset to use localhost on web, 10.0.2.2 on the Android emulator,
# and http://192.168.1.37:3000 on a phone on this Wi-Fi.
# EXPO_PUBLIC_API_URL=http://192.168.1.37:3000



# VacayPay MySQL — 192.168.1.42:5246, database vacaype
DB_HOST=192.168.1.42
DB_PORT=
DB_NAME=vacaype 
DB_USER=
DB_PASS=


JWT_SECRET=random_secret

# Nodemailer. Leave SMTP_HOST empty to print OTP codes in the server log.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@voyagepay.com

# Google OAuth — nextserver. Native Android sign-in issues an ID token for the Web client.
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=

# Docker: absolute path on the host to your .apk (any filename). Replace file in place for new releases.
APK_FILE=/home/pi/Desktop/projects/vacaypay/apk/app-release.apk

WEB_PORT=3000
MYSQL_PORT=3306
