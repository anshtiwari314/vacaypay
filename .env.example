## mobileApp 

# Google OAuth client ids. Use the same web client id as GOOGLE_CLIENT_ID on the server.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional. Leave unset to use localhost on web, 10.0.2.2 on the Android emulator,
# and http://192.168.1.37:3000 on a phone on this Wi-Fi.
# EXPO_PUBLIC_API_URL=http://192.168.1.37:3000



# VacayPay MySQL — 192.168.1.42:5246, database vacaype
DB_HOST=192.168.1.42
DB_PORT=
DB_NAME=vacaype 
DB_USER=
DB_PASS=


JWT_SECRET=random_secret

# Nodemailer. Leave SMTP_HOST empty to print OTP codes in the server log.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@voyagepay.com

# Comma-separated Google OAuth client ids (web, Android, iOS). The id token audience must match one of these.
GOOGLE_CLIENT_ID=
