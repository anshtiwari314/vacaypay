# Combined from nextserver/.gitignore and mobileApp/.gitignore.
# Patterns are repo-root relative so one git repo covers both apps.

*.html
scripts/
# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# expo
.expo/
dist/
web-build/
expo-env.d.ts

# native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# generated native projects
mobileApp/ios/
mobileApp/android/

# metro
.metro-health-check*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
npm-debug.*

# gradle user homes (local caches, machine-specific, never commit)
mobileApp/.gradle-home/
mobileApp/.gradle-user-home/
mobileApp/.gradle-package.log

# misc
.DS_Store
*.pem

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

example

# host-mounted APK drops (docker-compose → /apk)
apk-downloads/*
!apk-downloads/.gitkeep
